# Copy to .env and adjust as needed.
NODE_ENV=development
PORT=4000

# docker compose publishes Postgres on 5433 to avoid clashing with a local install.
DATABASE_URL=postgresql://cleen:cleen@localhost:5433/cleen?schema=public

# Change this in any non-local environment.
JWT_SECRET=dev-only-secret-change-me-please
JWT_EXPIRES_IN=12h

CORS_ORIGIN=http://localhost:5173

DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100
